---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { EMAIL, GITHUB_URL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About Yaocheng Tong" />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				I'm Yaocheng Tong, a Software Engineer II at <strong>Airbnb</strong> on the Payments and
				Financial Data team, working remotely from New Jersey.
			</p>
			<p>
				My main responsibility is a set of Spark and Airflow pipelines that turn raw payment data
				into the financial events Airbnb's finance teams rely on, plus part of the payments backend
				that feeds them. Most of the work is making those pipelines cheaper, faster, and harder to
				break, and fixing the data when an upstream system fails anyway.
			</p>
			<p>
				Lately that has included LLM-agent tools that run financial data investigations on their
				own, and working with the infrastructure team to evaluate self-hosted open-source models
				for internal use.
			</p>
			<p>M.S. and B.S. in Computer Engineering, Rutgers University.</p>
			<h2>Interests</h2>
			<ul>
				<li>Data pipelines and distributed systems (Scala, Spark, Airflow)</li>
				<li>AI infrastructure: serving, evaluation, and the plumbing that puts models in production</li>
				<li>Backend engineering (Java, Spring Boot), with the occasional React / TypeScript project</li>
			</ul>
			<h2>Contact</h2>
			<ul>
				<li>Email: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
				<li>GitHub: <a href={GITHUB_URL}>YaochengTong</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
